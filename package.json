{
  "name": "wife-cv-studio",
  "private": true,
  "version": "2.0.0",
  "description": "Lâm Thanh Tiệp — Portfolio Studio. Vite + React + TS. Vibe-based portfolio with per-vibe category layout adapters.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n vite,server -c magenta,cyan \"vite\" \"node server.cjs\"",
    "dev:vite": "vite",
    "dev:server": "node server.cjs",
    "build": "tsc -b && vite build && node scripts/copy-static.cjs",
    "preview": "vite preview",
    "serve": "node server.cjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "framer-motion": "^11.11.17",
    "gsap": "^3.12.5",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "zustand": "5.0.12"
  },
  "devDependencies": {
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "concurrently": "9.2.1",
    "typescript": "6.0.3",
    "vite": "8.0.9"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
